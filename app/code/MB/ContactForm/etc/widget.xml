<?xml version="1.0"?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="mb_contact_form" class="MB\ContactForm\Block\Widget\Form" is_email_compatible="false">
        <label translate="true">MB Contact Form</label>
        <description translate="true">Displays the configured contact form for allowed customer groups.</description>
        <parameters>
            <parameter name="title" xsi:type="text" visible="true" required="false" sort_order="10">
                <label translate="true">Custom Form Title</label>
                <description translate="true">Leave empty to use the Store View configuration.</description>
            </parameter>
        </parameters>
    </widget>
</widgets>
