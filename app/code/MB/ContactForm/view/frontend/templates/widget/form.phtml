<?php
/** @var \MB\ContactForm\Block\Widget\Form $block */
/** @var \Magento\Framework\Escaper $escaper */
$formId = $block->getFormId();
$captchaProvider = $block->getCaptchaProvider();
?>
<section class="mb-contact" aria-labelledby="<?= $escaper->escapeHtmlAttr($formId) ?>-title">
    <?php if ($block->getFormTitle() !== ''): ?>
        <h2 class="mb-contact__title" id="<?= $escaper->escapeHtmlAttr($formId) ?>-title">
            <?= $escaper->escapeHtml(__($block->getFormTitle())) ?>
        </h2>
    <?php endif; ?>

    <form class="mb-contact__form"
          id="<?= $escaper->escapeHtmlAttr($formId) ?>"
          action="<?= $escaper->escapeUrl($block->getPostUrl()) ?>"
          method="post"
          data-contact-form
          data-error-letters="<?= $escaper->escapeHtmlAttr(__('Please use Latin or Cyrillic letters and spaces only.')) ?>"
          data-error-alphanumeric="<?= $escaper->escapeHtmlAttr(__('Please use Latin or Cyrillic letters, numbers and spaces only.')) ?>"
          data-error-numbers="<?= $escaper->escapeHtmlAttr(__('Please use numbers only.')) ?>"
          data-error-email="<?= $escaper->escapeHtmlAttr(__('Please enter a valid email address.')) ?>"
          data-error-safe-text="<?= $escaper->escapeHtmlAttr(__('Please use Latin or Cyrillic letters, numbers and punctuation only.')) ?>"
          data-error-captcha="<?= $escaper->escapeHtmlAttr(__('Please complete the CAPTCHA verification.')) ?>">
        <?= $block->getBlockHtml('formkey') ?>

        <?php foreach ($block->getFields() as $field): ?>
            <?php $fieldId = $formId . '-' . preg_replace('/[^a-z0-9_-]/i', '-', $field['name']); ?>
            <div class="mb-contact__field<?= $field['type'] === 'textarea' ? ' mb-contact__field--full' : '' ?>">
                <label for="<?= $escaper->escapeHtmlAttr($fieldId) ?>">
                    <?= $escaper->escapeHtml($field['label']) ?>
                    <?php if ($field['required']): ?><span aria-hidden="true">*</span><?php endif; ?>
                </label>
                <?php if ($field['type'] === 'textarea'): ?>
                    <textarea id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
                              name="<?= $escaper->escapeHtmlAttr($field['name']) ?>"
                              rows="<?= $field['name'] === 'message' ? 7 : 5 ?>"
                              maxlength="<?= (int)$field['maxlength'] ?>"
                              data-validation="<?= $escaper->escapeHtmlAttr($field['validation']) ?>"
                              <?= $field['required'] ? 'required' : '' ?>></textarea>
                <?php elseif ($field['type'] === 'select'): ?>
                     <select id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
                             name="<?= $escaper->escapeHtmlAttr($field['name']) ?>"
                             data-validation="<?= $escaper->escapeHtmlAttr($field['validation']) ?>"
                             <?= $field['required'] ? 'required' : '' ?>>
                        <option value=""><?= $escaper->escapeHtml(__('Please select')) ?></option>
                        <?php foreach ($field['options'] as $option): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($option) ?>"><?= $escaper->escapeHtml($option) ?></option>
                        <?php endforeach; ?>
                    </select>
                <?php else: ?>
                    <input id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
                           name="<?= $escaper->escapeHtmlAttr($field['name']) ?>"
                           type="<?= $field['validation'] === 'email' ? 'email' : 'text' ?>"
                           autocomplete="<?= $escaper->escapeHtmlAttr(['firstname' => 'given-name', 'lastname' => 'family-name', 'email' => 'email', 'company' => 'organization', 'telephone' => 'tel'][$field['name']] ?? 'off') ?>"
                           maxlength="<?= (int)$field['maxlength'] ?>"
                           data-validation="<?= $escaper->escapeHtmlAttr($field['validation']) ?>"
                           <?= $field['required'] ? 'required' : '' ?>>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>

        <?php if ($captchaProvider !== 'none'): ?>
            <div class="mb-contact__captcha mb-contact__field--full"
                 data-contact-captcha-provider="<?= $escaper->escapeHtmlAttr($captchaProvider) ?>">
                <?php if ($captchaProvider === 'google'): ?>
                    <div class="g-recaptcha" data-sitekey="<?= $escaper->escapeHtmlAttr($block->getCaptchaSiteKey()) ?>"></div>
                <?php else: ?>
                    <div class="cf-turnstile" data-sitekey="<?= $escaper->escapeHtmlAttr($block->getCaptchaSiteKey()) ?>"></div>
                <?php endif; ?>
                <p class="mb-contact__captcha-error" role="alert" hidden></p>
            </div>
        <?php endif; ?>

        <div class="mb-contact__actions mb-contact__field--full">
            <button class="action primary" type="submit">
                <span><?= $escaper->escapeHtml($block->getLabel('submit')) ?></span>
            </button>
        </div>
    </form>
</section>
