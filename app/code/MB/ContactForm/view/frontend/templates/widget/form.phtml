<?php
/** @var \MB\ContactForm\Block\Widget\Form $block */
/** @var \Magento\Framework\Escaper $escaper */
$formId = $block->getFormId();
$captchaProvider = $block->getCaptchaProvider();
?>
<section class="mb-contact" aria-labelledby="<?= $escaper->escapeHtmlAttr($formId) ?>-title">
    <?php if ($block->getFormTitle() !== ''): ?>
        <h2 class="mb-contact__title" id="<?= $escaper->escapeHtmlAttr($formId) ?>-title">
            <?= $escaper->escapeHtml(__($block->getFormTitle())) ?>
        </h2>
    <?php endif; ?>

    <form class="mb-contact__form"
          id="<?= $escaper->escapeHtmlAttr($formId) ?>"
          action="<?= $escaper->escapeUrl($block->getPostUrl()) ?>"
          method="post"
          data-contact-form
          data-error-letters="<?= $escaper->escapeHtmlAttr(__('Please use Latin or Cyrillic letters and spaces only.')) ?>"
          data-error-alphanumeric="<?= $escaper->escapeHtmlAttr(__('Please use Latin or Cyrillic letters, numbers and spaces only.')) ?>"
          data-error-numbers="<?= $escaper->escapeHtmlAttr(__('Please use numbers only.')) ?>"
          data-error-email="<?= $escaper->escapeHtmlAttr(__('Please enter a valid email address.')) ?>"
          data-error-safe-text="<?= $escaper->escapeHtmlAttr(__('Please use Latin or Cyrillic letters, numbers and punctuation only.')) ?>"
          data-error-captcha="<?= $escaper->escapeHtmlAttr(__('Please complete the CAPTCHA verification.')) ?>">
        <?= $block->getBlockHtml('formkey') ?>

        <div class="mb-contact__field mb-contact__field--full">
            <label for="<?= $escaper->escapeHtmlAttr($formId) ?>-message">
                <?= $escaper->escapeHtml(__($block->getLabel('message'))) ?> <span aria-hidden="true">*</span>
            </label>
            <textarea id="<?= $escaper->escapeHtmlAttr($formId) ?>-message"
                      name="message"
                      rows="7"
                      maxlength="5000"
                      required
                      data-validation="safe_text"></textarea>
        </div>

        <div class="mb-contact__field">
            <label for="<?= $escaper->escapeHtmlAttr($formId) ?>-firstname">
                <?= $escaper->escapeHtml(__($block->getLabel('firstname'))) ?> <span aria-hidden="true">*</span>
            </label>
            <input id="<?= $escaper->escapeHtmlAttr($formId) ?>-firstname"
                   name="firstname"
                   type="text"
                   maxlength="100"
                   autocomplete="given-name"
                   required
                   data-validation="letters">
        </div>

        <div class="mb-contact__field">
            <label for="<?= $escaper->escapeHtmlAttr($formId) ?>-lastname">
                <?= $escaper->escapeHtml(__($block->getLabel('lastname'))) ?> <span aria-hidden="true">*</span>
            </label>
            <input id="<?= $escaper->escapeHtmlAttr($formId) ?>-lastname"
                   name="lastname"
                   type="text"
                   maxlength="100"
                   autocomplete="family-name"
                   required
                   data-validation="letters">
        </div>

        <div class="mb-contact__field">
            <label for="<?= $escaper->escapeHtmlAttr($formId) ?>-email">
                <?= $escaper->escapeHtml(__($block->getLabel('email'))) ?> <span aria-hidden="true">*</span>
            </label>
            <input id="<?= $escaper->escapeHtmlAttr($formId) ?>-email"
                   name="email"
                   type="email"
                   maxlength="254"
                   autocomplete="email"
                   inputmode="email"
                   required
                   data-validation="email">
        </div>

        <div class="mb-contact__field">
            <label for="<?= $escaper->escapeHtmlAttr($formId) ?>-company">
                <?= $escaper->escapeHtml(__($block->getLabel('company'))) ?>
            </label>
            <input id="<?= $escaper->escapeHtmlAttr($formId) ?>-company"
                   name="company"
                   type="text"
                   maxlength="150"
                   autocomplete="organization"
                   data-validation="alphanumeric">
        </div>

        <div class="mb-contact__field">
            <label for="<?= $escaper->escapeHtmlAttr($formId) ?>-telephone">
                <?= $escaper->escapeHtml(__($block->getLabel('telephone'))) ?>
            </label>
            <input id="<?= $escaper->escapeHtmlAttr($formId) ?>-telephone"
                   name="telephone"
                   type="tel"
                   maxlength="30"
                   autocomplete="tel"
                   inputmode="numeric"
                   data-validation="numbers">
        </div>

        <?php foreach ($block->getCustomFields() as $field): ?>
            <?php $fieldId = $formId . '-custom-' . $field['code']; ?>
            <div class="mb-contact__field<?= $field['type'] === 'textarea' ? ' mb-contact__field--full' : '' ?>">
                <label for="<?= $escaper->escapeHtmlAttr($fieldId) ?>">
                    <?= $escaper->escapeHtml(__($field['label'])) ?>
                    <?php if ($field['required']): ?><span aria-hidden="true">*</span><?php endif; ?>
                </label>
                <?php if ($field['type'] === 'textarea'): ?>
                    <textarea id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
                              name="custom[<?= $escaper->escapeHtmlAttr($field['code']) ?>]"
                              rows="5"
                              maxlength="1000"
                              data-validation="<?= $escaper->escapeHtmlAttr($field['validation']) ?>"
                              <?= $field['required'] ? 'required' : '' ?>></textarea>
                <?php elseif ($field['type'] === 'select'): ?>
                     <select id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
                             name="custom[<?= $escaper->escapeHtmlAttr($field['code']) ?>]"
                             data-validation="<?= $escaper->escapeHtmlAttr($field['validation']) ?>"
                             <?= $field['required'] ? 'required' : '' ?>>
                        <option value=""><?= $escaper->escapeHtml(__('Please select')) ?></option>
                        <?php foreach ($field['options'] as $option): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($option) ?>"><?= $escaper->escapeHtml(__($option)) ?></option>
                        <?php endforeach; ?>
                    </select>
                <?php else: ?>
                    <input id="<?= $escaper->escapeHtmlAttr($fieldId) ?>"
                           name="custom[<?= $escaper->escapeHtmlAttr($field['code']) ?>]"
                           type="<?= $field['validation'] === 'email' ? 'email' : 'text' ?>"
                           maxlength="255"
                           data-validation="<?= $escaper->escapeHtmlAttr($field['validation']) ?>"
                           <?= $field['required'] ? 'required' : '' ?>>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>

        <?php if ($captchaProvider !== 'none'): ?>
            <div class="mb-contact__captcha mb-contact__field--full"
                 data-contact-captcha-provider="<?= $escaper->escapeHtmlAttr($captchaProvider) ?>">
                <?php if ($captchaProvider === 'google'): ?>
                    <div class="g-recaptcha" data-sitekey="<?= $escaper->escapeHtmlAttr($block->getCaptchaSiteKey()) ?>"></div>
                <?php else: ?>
                    <div class="cf-turnstile" data-sitekey="<?= $escaper->escapeHtmlAttr($block->getCaptchaSiteKey()) ?>"></div>
                <?php endif; ?>
                <p class="mb-contact__captcha-error" role="alert" hidden></p>
            </div>
        <?php endif; ?>

        <div class="mb-contact__actions mb-contact__field--full">
            <button class="action primary" type="submit">
                <span><?= $escaper->escapeHtml(__($block->getLabel('submit'))) ?></span>
            </button>
        </div>
    </form>
</section>
